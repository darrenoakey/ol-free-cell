# Fastfile for ol-free-cell-refresh
# Auto-generated by app-publish

require "json"
require "shellwords"

BUNDLE_ID = "com.darrenoakey.olFreeCell"
TEAM_ID = "58MF5GATL7"
SCHEME = "App"
PROJECT = File.expand_path("../ios/App/App.xcodeproj", __dir__)
BUILD_DIR = File.expand_path("../build", __dir__)
API_KEY_JSON = File.expand_path("~/.appstoreconnect/api_key.json")

def api_key_config
  JSON.parse(File.read(API_KEY_JSON))
end

def shell_command(arguments)
  arguments.map { |argument| Shellwords.escape(argument) }.join(" ")
end

default_platform(:ios)

platform :ios do
  desc "Generate screenshots"
  lane :screenshots do
    capture_screenshots
  end

  desc "Archive and export an App Store IPA with automatic signing"
  lane :build do
    require "fileutils"
    config = api_key_config
    key_path = File.expand_path(
      "~/.appstoreconnect/private_keys/AuthKey_#{config.fetch('key_id')}.p8"
    )
    archive_path = "#{BUILD_DIR}/ol-free-cell-refresh.xcarchive"
    export_path = "#{BUILD_DIR}/export"
    export_options = "#{BUILD_DIR}/ExportOptions.plist"
    build_number = Time.now.utc.strftime("%y%m%d%H%M")

    FileUtils.mkdir_p(BUILD_DIR)
    File.write("#{BUILD_DIR}/build_number.txt", build_number)
    File.write(export_options, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>app-store</string>
        <key>teamID</key><string>#{TEAM_ID}</string>
        <key>signingStyle</key><string>automatic</string>
        <key>uploadSymbols</key><true/>
        <key>destination</key><string>export</string>
      </dict>
      </plist>
    PLIST
    FileUtils.rm_rf([archive_path, export_path])

    sh(shell_command([
      "xcodebuild",
      "-project", PROJECT,
      "-scheme", SCHEME,
      "-configuration", "Release",
      "-archivePath", archive_path,
      "-destination", "generic/platform=iOS",
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", config.fetch("key_id"),
      "-authenticationKeyIssuerID", config.fetch("issuer_id"),
      "CODE_SIGN_STYLE=Automatic",
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "archive"
    ]))

    sh(shell_command([
      "xcodebuild",
      "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", export_path,
      "-exportOptionsPlist", export_options,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", config.fetch("key_id"),
      "-authenticationKeyIssuerID", config.fetch("issuer_id")
    ]))

    app_path = Dir["#{archive_path}/Products/Applications/*.app"].first
    UI.user_error!("No .app inside #{archive_path}") unless app_path
    marketing_version = sh(
      "/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' " \
      "#{Shellwords.escape("#{app_path}/Info.plist")}",
      log: false
    ).strip
    UI.user_error!("Empty marketing version in #{app_path}") if marketing_version.empty?
    File.write("#{BUILD_DIR}/version.txt", marketing_version)
  end

  desc "Upload the exported IPA without submitting it"
  lane :upload_binary do
    ipa = Dir["#{BUILD_DIR}/export/*.ipa"].first
    UI.user_error!("No IPA found in #{BUILD_DIR}/export") unless ipa
    upload_to_app_store(
      api_key_path: API_KEY_JSON,
      ipa: ipa,
      skip_screenshots: true,
      skip_metadata: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Wait for the build produced by the build lane to finish processing"
  lane :wait_for_processing do
    stamp = "#{BUILD_DIR}/build_number.txt"
    UI.user_error!("No build number recorded; run the build lane first") unless File.exist?(stamp)
    script = File.expand_path("../scripts/wait_for_build.py", __dir__)
    sh(shell_command(["python3", script, File.read(stamp).strip]))
  end

  desc "Submit the processed build for App Store review"
  lane :submit do
    build_stamp = "#{BUILD_DIR}/build_number.txt"
    version_stamp = "#{BUILD_DIR}/version.txt"
    UI.user_error!("No build number recorded; run the build lane first") unless File.exist?(build_stamp)
    UI.user_error!("No marketing version recorded; run the build lane first") unless File.exist?(version_stamp)
    upload_to_app_store(
      api_key_path: API_KEY_JSON,
      app_identifier: BUNDLE_ID,
      app_version: File.read(version_stamp).strip,
      build_number: File.read(build_stamp).strip,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      phased_release: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: false,
        add_id_info_uses_idfa: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
