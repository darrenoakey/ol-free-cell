#!/bin/bash
# run - Project commands for ol-free-cell

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CHECK_DERIVED_DATA="$SCRIPT_DIR/local/check-derived-data"

usage() {
    cat <<'EOF'
Usage: ./run <command> [args]

Commands:
  check          Run the complete greenline quality gate (540-second deadline)
  deploy         Prove the current SHA with the App Store preflight workflow
  health         Verify a successful App Store preflight for the current SHA
  device [name]  Sync, build, install, and launch on a device (default: Starbuck)
  status         Show the app-publish pipeline status
  publish        Run the full local App Store publish pipeline
  help           Show this help
EOF
}

app_publish_run() {
    local git_common_dir
    local app_publish

    git_common_dir="$(git -C "$SCRIPT_DIR" rev-parse --path-format=absolute --git-common-dir)"
    app_publish="$(cd "$(dirname "$git_common_dir")/.." && pwd)/app-publish/run"
    if [[ ! -x "$app_publish" ]]; then
        echo "ERROR: app-publish executable not found at $app_publish" >&2
        echo "Expected app-publish beside the canonical ol-free-cell checkout." >&2
        return 1
    fi
    printf '%s\n' "$app_publish"
}

current_sha() {
    git -C "$SCRIPT_DIR" rev-parse HEAD
}

matching_preflight_runs() {
    local repository="$1"
    local sha="$2"
    local branch="${3:-}"
    local args=(
        run list
        --repo "$repository"
        --workflow appstore.yml
        --event workflow_dispatch
        --limit 100
        --json databaseId,headSha,event,status,conclusion
    )

    if [[ -n "$branch" ]]; then
        args+=(--branch "$branch")
    fi
    gh "${args[@]}" \
        --jq ".[] | select(.headSha == \"$sha\" and .event == \"workflow_dispatch\") | [.databaseId, .status, .conclusion] | @tsv"
}

cleanup_preflight_branch() {
    if [[ -n "${PREFLIGHT_REMOTE_REF:-}" && -n "${PREFLIGHT_SHA:-}" ]]; then
        git -C "$SCRIPT_DIR" push \
            --force-with-lease="$PREFLIGHT_REMOTE_REF:$PREFLIGHT_SHA" \
            origin ":$PREFLIGHT_REMOTE_REF" >/dev/null 2>&1 ||
            echo "WARNING: temporary branch was not removed because its remote value changed" >&2
    fi
}

deploy_preflight() {
    local sha branch repository remote_sha known_ids run_id run_state candidate_id
    local discovery_deadline run_deadline
    local -a new_run_ids

    sha="$(current_sha)"
    branch="greenline-preflight/$sha"
    repository="$(cd "$SCRIPT_DIR" && gh repo view --json nameWithOwner --jq .nameWithOwner)"
    remote_sha="$(git -C "$SCRIPT_DIR" ls-remote --heads origin "refs/heads/$branch" | awk '{print $1}')"

    PREFLIGHT_SHA="$sha"
    PREFLIGHT_REMOTE_REF="refs/heads/$branch"
    trap cleanup_preflight_branch EXIT

    git -C "$SCRIPT_DIR" push \
        --force-with-lease="$PREFLIGHT_REMOTE_REF:${remote_sha:-}" \
        origin "$sha:$PREFLIGHT_REMOTE_REF"

    known_ids="$(
        while IFS=$'\t' read -r candidate_id _; do
            printf '%s\n' "$candidate_id"
        done < <(matching_preflight_runs "$repository" "$sha" "$branch")
    )"
    known_ids=$'\n'"$known_ids"$'\n'

    gh workflow run appstore.yml \
        --repo "$repository" \
        --ref "$branch" \
        --field mode=preflight \
        --field submit=false

    run_id=""
    discovery_deadline=$((SECONDS + 180))
    while ((SECONDS < discovery_deadline)); do
        new_run_ids=()
        while IFS=$'\t' read -r candidate_id _; do
            if [[ -n "$candidate_id" && "$known_ids" != *$'\n'"$candidate_id"$'\n'* ]]; then
                new_run_ids+=("$candidate_id")
            fi
        done < <(matching_preflight_runs "$repository" "$sha" "$branch")
        if ((${#new_run_ids[@]} > 1)); then
            echo "ERROR: multiple new matching workflow_dispatch runs appeared for $sha" >&2
            return 1
        fi
        if ((${#new_run_ids[@]} == 1)); then
            run_id="${new_run_ids[0]}"
            break
        fi
        sleep 5
    done
    if [[ -z "$run_id" ]]; then
        echo "ERROR: no matching workflow_dispatch run appeared for $sha" >&2
        return 1
    fi

    run_deadline=$((SECONDS + 1800))
    while ((SECONDS < run_deadline)); do
        run_state="$(
            gh run view "$run_id" --repo "$repository" \
                --json status,conclusion \
                --jq '[.status, .conclusion] | @tsv'
        )"
        if [[ "$run_state" == completed$'\t'success ]]; then
            printf 'App Store preflight succeeded for %s (run %s)\n' "$sha" "$run_id"
            cleanup_preflight_branch
            PREFLIGHT_REMOTE_REF=""
            trap - EXIT
            return 0
        fi
        if [[ "$run_state" == completed$'\t'* ]]; then
            echo "ERROR: App Store preflight run $run_id finished with ${run_state#*$'\t'}" >&2
            return 1
        fi
        sleep 10
    done

    echo "ERROR: App Store preflight run $run_id exceeded its 1800-second deadline" >&2
    return 1
}

health_preflight() {
    local sha repository run_id

    sha="$(current_sha)"
    repository="$(cd "$SCRIPT_DIR" && gh repo view --json nameWithOwner --jq .nameWithOwner)"
    run_id=""
    while IFS=$'\t' read -r candidate_id status conclusion; do
        if [[ "$status" == "completed" && "$conclusion" == "success" ]]; then
            run_id="$candidate_id"
            break
        fi
    done < <(matching_preflight_runs "$repository" "$sha")
    if [[ -z "$run_id" ]]; then
        echo "ERROR: no successful appstore.yml workflow_dispatch run found for $sha" >&2
        return 1
    fi
    printf 'App Store preflight is healthy for %s (run %s)\n' "$sha" "$run_id"
}

bootstrap_release_gate() {
    bash -n "$SCRIPT_DIR/run"
    ruby -ryaml -e '
path = ARGV.fetch(0)
YAML.respond_to?(:unsafe_load_file) ? YAML.unsafe_load_file(path) : YAML.load_file(path)
' "$SCRIPT_DIR/.github/workflows/appstore.yml"
    ruby -c "$SCRIPT_DIR/fastlane/Fastfile" >/dev/null
    /usr/bin/python3 - "$SCRIPT_DIR/scripts/wait_for_build.py" <<'PY'
import ast
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
PY
    (cd "$SCRIPT_DIR" && gh repo view --json nameWithOwner --jq .nameWithOwner >/dev/null)
    echo "Bootstrap release gate passed."
}

check_steps() {
    cd "$SCRIPT_DIR"

    # V8 compile cache: collapses cucumber/playwright module-load time on warm
    # worktrees (bdd-web spends ~40s loading modules, ~17s executing).
    export NODE_COMPILE_CACHE="$SCRIPT_DIR/local/node-compile-cache"
    # Per-step wall-clock instrumentation so slow releases are evidence, not
    # guesswork. Lines go to stderr: [check-timing] NAME: Ns (total Ns)
    CHECK_T0=$SECONDS
    step() {
        local name="$1"; shift
        local t0=$SECONDS
        "$@"
        local rc=$?
        echo "[check-timing] $name: $((SECONDS - t0))s (total $((SECONDS - CHECK_T0))s)" >&2
        return $rc
    }

    # Suites follow the candidate diff. Unknown files fail closed to every
    # suite. A version bump still goes through the App Store preflight.
    if ! SUITES="$(node "$SCRIPT_DIR/scripts/check-impact.mjs" "$SCRIPT_DIR")"; then
        echo "ERROR: check-impact failed; running the full suite" >&2
        SUITES=$'verify-core\nunit-tests\nnpm-audit\nbdd-web\ncap-sync\nios-test\nresolve-packages'
    fi
    need() { printf '%s\n' "$SUITES" | grep -qx "$1"; }
    skip() {
        echo "[check-timing] $1: skipped, change impact (total $((SECONDS - CHECK_T0))s)" >&2
    }

    mkdir -p "$SCRIPT_DIR/local"
    BDD_WEB_PID=""
    if need bdd-web; then
        BDD_WEB_LOG="$SCRIPT_DIR/local/bdd-web.log"
        npm run test:bdd:web >"$BDD_WEB_LOG" 2>&1 &
        BDD_WEB_PID=$!
    fi

    # Boot the gate simulator while the cheap steps run. Do not simctl
    # terminate SpringBoard: abandoning that terminate leaves the simulator
    # rebooting, and xcodebuild then waits ~180s before the test runner starts.
    SIM_SETUP_PID=""
    SIM_READY_FILE=""
    if need ios-test; then
        SIM_NAME="ol-free-cell-gate"
        SIM_TYPE="com.apple.CoreSimulator.SimDeviceType.iPhone-16-Pro-Max"
        SIM_RUNTIME="com.apple.CoreSimulator.SimRuntime.iOS-18-0"
        SIM_UDID_CACHE="$SCRIPT_DIR/local/gate-simulator-udid"
        SIM_READY_FILE="$(mktemp -t ol-free-cell-sim-ready)"
        (
            SIM_UDID=""
            if [[ -s "$SIM_UDID_CACHE" ]]; then
                SIM_UDID="$(tr -d '[:space:]' < "$SIM_UDID_CACHE")"
            fi
            if [[ -z "$SIM_UDID" ]]; then
                SIM_UDID="$(xcrun simctl list devices available | awk -F '[()]' -v name="$SIM_NAME" '$0 ~ ("^[[:space:]]*" name " \\(") { print $2; exit }')"
                if [[ -z "$SIM_UDID" ]]; then
                    xcrun simctl list runtimes available | grep -Fq -- "$SIM_RUNTIME" || {
                        echo "ERROR: required iOS 18.0 simulator runtime is unavailable" >&2
                        exit 1
                    }
                    xcrun simctl create "$SIM_NAME" "$SIM_TYPE" "$SIM_RUNTIME" >/dev/null
                    SIM_UDID="$(xcrun simctl list devices available | awk -F '[()]' -v name="$SIM_NAME" '$0 ~ ("^[[:space:]]*" name " \\(") { print $2; exit }')"
                fi
                if [[ -z "$SIM_UDID" ]]; then
                    echo "ERROR: could not create the $SIM_NAME simulator" >&2
                    exit 1
                fi
                printf '%s\n' "$SIM_UDID" > "$SIM_UDID_CACHE"
            fi
            xcrun simctl boot "$SIM_UDID" >/dev/null 2>&1 || true
            xcrun simctl bootstatus "$SIM_UDID" -b >/dev/null
            printf '%s\n' "$SIM_UDID" > "$SIM_READY_FILE"
        ) &
        SIM_SETUP_PID=$!
    fi

    step verify-core node "$HOME/src/ol-core/scripts/verify-core.mjs" "$SCRIPT_DIR/web"
    step unit-tests node --test tests/unit/

    # npm ci only when dependencies actually changed; node_modules is kept warm
    # in the persistent gate worktree. The hidden lockfile npm ci writes is the
    # freshness marker.
    if [[ ! -d node_modules ]] || [[ package-lock.json -nt node_modules/.package-lock.json ]]; then
        step npm-ci npm ci
    else
        echo "[check-timing] npm-ci: skipped, node_modules matches package-lock.json (total $((SECONDS - CHECK_T0))s)" >&2
    fi
    step npm-audit npm audit

    if need cap-sync; then
        step cap-sync npx --no-install cap sync ios
    else
        skip cap-sync
    fi

    if need ios-test; then
        # simctl list/bootstatus can wedge. Setup is already in the background;
        # abandon it instead of holding the gate for the whole check deadline.
        i=0
        while kill -0 "$SIM_SETUP_PID" 2>/dev/null && [ "$i" -lt 45 ]; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$SIM_SETUP_PID" 2>/dev/null; then
            echo "ERROR: simulator setup exceeded 45s" >&2
            pkill -TERM -P "$SIM_SETUP_PID" 2>/dev/null || true
            kill "$SIM_SETUP_PID" 2>/dev/null || true
            exit 1
        fi
        wait "$SIM_SETUP_PID" || { echo "ERROR: simulator setup failed" >&2; exit 1; }
        SIM_UDID="$(cat "$SIM_READY_FILE")"
        rm -f "$SIM_READY_FILE"

        # Warm checkouts skip SPM resolution. Resolving capacitor-swift-pm on
        # every release is the ~100s before an incremental test build.
        XCODE_PKG_ARG=""
        if ! need resolve-packages && [[ -d "$CHECK_DERIVED_DATA/SourcePackages/checkouts" ]]; then
            XCODE_PKG_ARG="-disableAutomaticPackageResolution"
        fi
        step ios-test xcodebuild \
            -project "$SCRIPT_DIR/ios/App/App.xcodeproj" \
            -scheme App \
            -configuration Release \
            -destination "platform=iOS Simulator,id=$SIM_UDID" \
            -derivedDataPath "$CHECK_DERIVED_DATA" \
            ${XCODE_PKG_ARG:+$XCODE_PKG_ARG} \
            CODE_SIGNING_ALLOWED=NO \
            EXCLUDED_ARCHS=x86_64 \
            DEBUG_INFORMATION_FORMAT=dwarf \
            COMPILER_INDEX_STORE_ENABLE=NO \
            ENABLE_PREVIEWS=NO \
            -parallel-testing-enabled NO \
            -only-testing:AppUITests \
            test
    else
        skip ios-test
    fi

    if [[ -n "$BDD_WEB_PID" ]]; then
        wait "$BDD_WEB_PID" || {
            echo "ERROR: bdd-web failed; last output:" >&2
            tail -n 40 "$BDD_WEB_LOG" >&2
            exit 1
        }
        echo "[check-timing] bdd-web: done (see $BDD_WEB_LOG) (total $((SECONDS - CHECK_T0))s)" >&2
    else
        skip bdd-web
    fi
}

check_with_deadline() {
    /usr/bin/python3 - "$SCRIPT_DIR/run" <<'PY'
import os
import signal
import subprocess
import sys

process = subprocess.Popen([sys.argv[1], "__check_steps"], start_new_session=True)
try:
    result = process.wait(timeout=540)
except subprocess.TimeoutExpired:
    print("ERROR: check exceeded its 540-second deadline", file=sys.stderr)
    os.killpg(process.pid, signal.SIGTERM)
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()
    raise SystemExit(124)
raise SystemExit(result)
PY
}

case "${1:-help}" in
    check)
        check_with_deadline
        ;;
    __check_steps)
        check_steps
        ;;
    bootstrap-release-gate)
        bootstrap_release_gate
        ;;
    deploy)
        deploy_preflight
        ;;
    health)
        health_preflight
        ;;
    publish)
        "$(app_publish_run)" --project "$SCRIPT_DIR" publish
        ;;
    device)
        "$(app_publish_run)" --project "$SCRIPT_DIR" deploy "${2:-Starbuck}"
        ;;
    status)
        "$(app_publish_run)" --project "$SCRIPT_DIR" status
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "ERROR: unsupported command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
